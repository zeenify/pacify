DATABASE_URL=postgres://user:pass@host/db?sslmode=require
GEMINI_API_KEY=your_ai_studio_key_here
PORT=3001

# LLM Provider (cloudflare | azure | azure-responses | gemini-interactions | openai)
LLM_PROVIDER=cloudflare

# Cloudflare Workers AI (used when LLM_PROVIDER=cloudflare)
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_api_token
PERSONALITY_MODEL=@cf/openai/gpt-oss-20b
PERSONALITY_EFFORT=medium

# Azure AI Foundry (used when LLM_PROVIDER=azure) — xAI Grok models
AZURE_AI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_API_KEY=your_azure_api_key
AZURE_MODEL=grok-4-1-fast-reasoning
AZURE_MAX_TOKENS=16000
AZURE_TEMPERATURE=1
AZURE_TOP_P=1

# Azure OpenAI Responses API (used when LLM_PROVIDER=azure-responses) — GPT-5 series
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_MAX_TOKENS=16000
AZURE_OPENAI_TEMPERATURE=1
AZURE_OPENAI_TOP_P=1
AZURE_OPENAI_REASONING_EFFORT=medium  # low | medium | high

# Gemini (AI Studio) — stateful Interactions API (used when LLM_PROVIDER=gemini-interactions)
# Server holds the conversation; only the round delta is sent each pick.
GEMINI_API_KEY=your_ai_studio_key_here
GEMINI_MODEL=gemma-4-31b-it
# Optional: override the Interactions API base URL (e.g. for a stub server)
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Thinking effort for gemini-interactions (thinking_level). gemma-4 models accept
# only "minimal" (no thinking, fastest) | "high". Omit for dynamic default (slowest).
# GEMINI_EFFORT=minimal

# OpenAI-compatible endpoint (used when LLM_PROVIDER=openai) — e.g. River, DeepSeek, GLM.
# Klein's dialogue runs on TWO roles tuned separately:
#   story    — preludes, post-duel epilogues, episodic memories: the STRONGEST model
#              you have (e.g. a full GLM / DeepSeek reasoning deployment) with deep
#              reasoning. These run while the player reads, not mid-sentence.
#   dialogue — live duel lines and reveal reactions: a fast model with light
#              reasoning so Klein answers between heartbeats.
# Each role falls back to OPENAI_MODEL when its override is unset.
OPENAI_BASE_URL=https://api.river.ai/v1
OPENAI_API_KEY=your_openai_compatible_key
OPENAI_MODEL=zai-org/GLM-5.3
OPENAI_TEMPERATURE=0.9
OPENAI_STORY_MODEL=zai-org/GLM-5.3
OPENAI_DIALOGUE_MODEL=zai-org/GLM-5.3-Flash
OPENAI_STORY_EFFORT=high
OPENAI_DIALOGUE_EFFORT=medium
# Abort budget for any single request (default 45000).
# OPENAI_REQUEST_TIMEOUT_MS=45000
# Optional caps (defaults: 4096 tokens).
# OPENAI_MAX_TOKENS=4096
# Klein scene/epilogue/memory generation time budget in ms (default 20000).
# KLEIN_SCENE_BUDGET_MS=20000

# --- Fish Audio voice (Klein's speech) — OPTIONAL, server-only -----------------
# Voice is off unless ALL of the below are valid; missing/invalid config is safe:
# the game plays text-only and never silently falls back to a paid model.
# These values live ONLY in the server environment (local apps/server/.env or the
# deployment secret store). NEVER put them in apps/web or any VITE_* variable —
# the browser must not see the key.
# Set to "true" to turn voice on.
FISH_ENABLED=false
# Fish Audio API key — server-only secret. SECURITY: if this key was ever pasted
# into chat, rotate it before live use and configure the replacement directly
# here / in your deployment secret store (never in source or client env).
FISH_API_KEY=your_fish_audio_key
# PINNED free model. The server accepts exactly "s2.1-pro-free" — a typo disables
# voice rather than silently hitting Fish's paid model. Fish documents free access
# through 2026-11-30 with fair-use limits and NO latency guarantee; when it
# lapses voice simply turns off. Keep voice optional; do not switch to a paid
# model without explicitly deciding to.
FISH_MODEL=s2.1-pro-free
# Klein's voice: the public "Thoma" clone. CAVEAT: it is a community clone, NOT
# marked as Fish-licensed — its availability or title on Fish is not proof of
# rights clearance for a public release.
FISH_KLEIN_VOICE_ID=ec47a6d54dbe4e1481f66e1d6a94b849
# Comma-separated web origins allowed to request speech (must match the browser
# origin exactly). Required when voice is enabled.
FISH_ALLOWED_ORIGINS=http://localhost:8081
# PRIVACY: with voice on, Fish receives the exact spoken dialogue text, which may
# include the player's chosen name. Fish's terms allow using submitted data for
# model improvement — keep voice optional and disclose this before any release.

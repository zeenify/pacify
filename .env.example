DATABASE_URL=postgres://user:pass@host/db?sslmode=require
GEMINI_API_KEY=your_ai_studio_key_here
PORT=3001

# LLM Provider (cloudflare | azure | azure-responses)
LLM_PROVIDER=cloudflare

# Cloudflare Workers AI (used when LLM_PROVIDER=cloudflare)
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_api_token
PERSONALITY_MODEL=@cf/openai/gpt-oss-20b
PERSONALITY_EFFORT=medium

# Azure AI Foundry (used when LLM_PROVIDER=azure) — xAI Grok models
AZURE_AI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_API_KEY=your_azure_api_key
AZURE_MODEL=grok-4-1-fast-reasoning
AZURE_MAX_TOKENS=16000
AZURE_TEMPERATURE=1
AZURE_TOP_P=1

# Azure OpenAI Responses API (used when LLM_PROVIDER=azure-responses) — GPT-5 series
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
AZURE_OPENAI_API_KEY=your_azure_openai_key
AZURE_OPENAI_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_MAX_TOKENS=16000
AZURE_OPENAI_TEMPERATURE=1
AZURE_OPENAI_TOP_P=1
AZURE_OPENAI_REASONING_EFFORT=medium  # low | medium | high
